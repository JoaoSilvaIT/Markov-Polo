# -----------------------------------------------------------------------------
# Hyperliquid Dual-Engine Perpetuals Trading Bot Configuration
# -----------------------------------------------------------------------------

# 1. Exchange Environment
# true = Hyperliquid Mainnet (https://api.hyperliquid.xyz)
# false = Hyperliquid Testnet (https://api.hyperliquid-testnet.xyz)
HL_IS_MAINNET=true

# 2. Wallet Credentials
# HL_PRIVATE_KEY: Private key of your dedicated Agent API Wallet (Recommended: no withdrawal permissions).
# Format: 64-character hexadecimal starting with 0x.
HL_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HL_WALLET_ADDRESS: Your main Hyperliquid trading account address (the address holding the collateral).
HL_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# 3. Target Asset Symbols (Multi-asset cluster: BTC, ETH, SOL, AVAX)
HL_PORTFOLIO_SYMBOLS=BTC,ETH,SOL,AVAX
HL_TRADING_SYMBOL=BTC

# 4. Cluster Risk & Leverage Configuration
# Maximum concurrent positions across all 4 coins (Default: 2)
HL_MAX_CONCURRENT_POSITIONS=2

# Exchange margin leverage (Default: 3x). Real notional leverage is risk-controlled by the bot (<1.0x).
HL_LEVERAGE=3
HL_IS_CROSS=true

# 5. Position Sizing & Compounding
# Sizing mode: "dynamic" (auto-scales with account equity) or "fixed"
HL_SIZING_MODE=dynamic

# Equity fraction allocated as base trade bank per position slot (Default: 0.35 = 35%)
HL_EQUITY_FRACTION=0.35

# Maximum position size ceiling in USDC (Default: 350.0). Bot dynamically caps below this based on asset volatility.
HL_MAX_POSITION_SIZE_USDC=350.0

# Fallback position size in USDC if live balance query fails
POSITION_SIZE_USDC=60.0

# 6. Strategy Parameters
# Engine B (Trend Breakout) mode: "live" (active trading) or "shadow" (telemetry only)
HL_TREND_ENGINE_MODE=live
HL_TREND_RISK_FRACTION=0.28
HL_DONCHIAN_PERIOD=12
HL_CHANDELIER_ATR_MULT=2.0

# 7. Monitoring & Telemetry
# Optional Discord Webhook URL for real-time order fill, take-profit, and stop-loss notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Web Dashboard Port (Default: 8088)
DASHBOARD_PORT=8088
