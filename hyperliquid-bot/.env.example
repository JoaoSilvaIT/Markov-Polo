# ==============================================================================
# Hyperliquid Autonomous O-U Quantitative Trading Bot Configuration
# ==============================================================================

# 1. Hyperliquid API Agent Wallet Key (hex format starting with 0x)
# Recommended: Create an API Agent Wallet on https://app.hyperliquid.xyz/API
# This delegates trading execution without granting withdrawal permissions.
HL_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 2. Main Hyperliquid Account Wallet Address (where your USDC collateral lives)
HL_WALLET_ADDRESS=0xYourMainHyperliquidAccountAddressHere

# 3. Environment: true = Mainnet (https://api.hyperliquid.xyz), false = Testnet
HL_IS_MAINNET=true

# 4. Target Asset Symbol (BTC, ETH, SOL, AVAX)
HL_TRADING_SYMBOL=BTC

# 4b. Cluster Portfolio Assets (Used for dynamic cluster lease discovery & position fences)
HL_PORTFOLIO_SYMBOLS=BTC,ETH,SOL,AVAX

# 5. Position Sizing in USDC notional (Default: 25.0 USDC)
POSITION_SIZE_USDC=25.0

# 6. Exchange Leverage & Margin Mode
# Default leverage: 3x (clamped between 1x and 20x). Set to 1 for spot-equivalent margin.
HL_LEVERAGE=3
# Margin Mode: true = Cross Margin, false = Isolated Margin
HL_IS_CROSS=true

# 7. Discord Alerts (Optional Webhook for real-time order/fill/TP/stop alerts)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# 8. Web Dashboard Port (Default: 8088)
DASHBOARD_PORT=8088
